{
    "name": "kintai/kintai",
    "description": "Lightweight open-source shift management system",
    "type": "project",
    "version": "0.8.1",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.3",
        "erusev/parsedown": "^1.8",
        "illuminate/database": "^13.19",
        "mpdf/mpdf": "^8.3",
        "phpoffice/phpspreadsheet": "^5.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "kintai\\": "src/"
        },
        "files": [
            "src/Core/helpers.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "kintai\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.32"
        }
    }
}
