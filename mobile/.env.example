# URL de base de l'API Kintai, joignable depuis le téléphone/émulateur (pas
# 127.0.0.1 ni 127.0.0.7 : l'appareil mobile n'est pas la machine qui fait
# tourner XAMPP). En Wi-Fi local, utiliser l'IP LAN du PC hôte — le
# VirtualHost catch-all d'Apache (httpd-vhosts.conf) répond déjà sur toute IP
# non réservée, donc aucune config serveur supplémentaire n'est nécessaire.
EXPO_PUBLIC_API_URL=http://192.168.1.10/api/v1
